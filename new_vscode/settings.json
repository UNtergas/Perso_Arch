{
  "workbench.editor.showTabs": "single",
  "window.menuBarVisibility": "toggle",
  "workbench.layoutControl.enabled": false,
  "workbench.browser.showInTitleBar": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.titleBar.signIn.enabled": false,
  "editor.tabSize": 2,
  "editor.lineNumbers": "relative",
  "window.titleBarStyle": "native",
  "window.menuStyle": "custom",
  "workbench.notifications.showInTitleBar": false,
  "workbench.navigationControl.enabled": false,
  "window.commandCenter": false,
  "update.titleBar": false,

  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "workbench.activityBar.compact": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.scrollbar.vertical": "visible",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.tabSizingFixedMaxWidth": 80,
  "breadcrumbs.filePath": "off",
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.codeLensFontFamily": "JetBrainsMono Nerd Font",
  "editor.inlayHints.fontFamily": "JetBrainsMono Nerd Font",
  "editor.inlineSuggest.fontFamily": "JetBrainsMono Nerd Font",
  "debug.console.fontFamily": "JetBrainsMono Nerd Font Mono",
  "scm.inputFontFamily": "JetBrainsMono Nerd Font",
  "notebook.output.fontFamily": "JetBrainsMono Nerd Font",
  "chat.editor.fontFamily": "JetBrainsMono Nerd Font",
  "errorLens.statusBarIconsEnabled": true,
  "breadcrumbs.enabled": false,
  "editor.fontLigatures": true,
  "workbench.tree.indent": 12,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.commandPalette.history": 20,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.showTabIndex": true,
  "workbench.startupEditor": "none",
  "workbench.editor.wrapTabs": true,
  
  "editor.glyphMargin": false,
  "editor.showFoldingControls": "always",
  "workbench.editor.doubleClickTabToToggleEditorGroupSizes": "off",
  "workbench.editor.empty.hint": "hidden",
  "workbench.iconTheme": "chalice-icon-theme",
  "workbench.enableExperiments": false,
  "telemetry.telemetryLevel": "off",
  "workbench.activityBar.location": "hidden",
  "markdown-preview-enhanced.previewTheme": "github-light.css",
  "markdown-preview-enhanced.enablePreviewZenMode": false,
  "tinymist.exportPdf": "onSave",
  "workbench.browser.searchEngine": "duckduckgo",
  "workbench.browser.openLocalhostLinks": true,
  //Add following lines of code to exclude the files & folders which aren't important for watchers to look for changes...
  //exludes fies & folders in search indexing
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
  },
  //exludes fies & folders for watcher service
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/env/**": true,
    "**/venv/**": true,
    "env-*": true
  },
  "explorer.confirmPasteNative": false,
  "python.analysis.typeCheckingMode": "basic",
  "window.customTitleBarVisibility": "never",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "editor.guides.highlightActiveIndentation": "always",
  "editor.tokenColorCustomizations": {},
  "editor.fontWeight": "400",
  "markdown-preview-enhanced.revealjsTheme": "vscode.css",
  "workbench.editor.tabSizing": "shrink",
  "python.analysis.autoImportCompletions": true,   // ← the key one; often defaults off
  "python.analysis.indexing": true,                 // must be on for it to know your symbols
  "python.terminal.useEnvFile": true,
  "explorer.confirmDragAndDrop": false,
  "markdown-preview-enhanced.plantumlJarPath": "/usr/share/plantuml/plantuml.jar",

  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "vim.easymotion": true,
  "vim.useSystemClipboard": true,
  "vim.leader": "<space>",

  // flash-like look: dim backdrop, bright labels
  "vim.easymotionDimBackground": true,
  "vim.easymotionMarkerFontWeight": "bold",
  "vim.easymotionIncSearchForegroundColor": "#c53b53",
  // home-row labels, flash order
  "vim.easymotionKeys": "asdfghjklqwertyuiopzxcvbnm",

  // ==== nvim keys (generated by new_vscode/build.py from the nvim setup: edit the script, not this block) ====
  // normal mode: leader (SPC) maps, g / ] / [ maps, ; = :
  "vim.normalModeKeyBindingsNonRecursive": [
    {"before": ["s"], "after": ["<leader>", "<leader>", "/"]},
    {"before": ["<leader>", "<leader>"], "commands": ["workbench.action.quickOpen"]},
    {"before": ["<leader>", "."], "commands": ["workbench.action.quickOpen"]},
    {"before": ["<leader>", ","], "commands": ["workbench.action.showAllEditors"]},
    {"before": ["<leader>", "b", "b"], "commands": ["workbench.action.showAllEditors"]},
    {"before": ["<leader>", "b", "S"], "commands": ["workbench.action.files.saveAll"]},
    {"before": ["<leader>", ":"], "commands": ["workbench.action.showCommands"]},
    {"before": ["<leader>", "e"], "commands": ["workbench.view.explorer"]},
    {"before": ["<leader>", "1"], "commands": ["workbench.action.openEditorAtIndex1"]},
    {"before": ["<leader>", "2"], "commands": ["workbench.action.openEditorAtIndex2"]},
    {"before": ["<leader>", "3"], "commands": ["workbench.action.openEditorAtIndex3"]},
    {"before": ["<leader>", "4"], "commands": ["workbench.action.openEditorAtIndex4"]},
    {"before": ["<leader>", "5"], "commands": ["workbench.action.openEditorAtIndex5"]},
    {"before": ["<leader>", "6"], "commands": ["workbench.action.openEditorAtIndex6"]},
    {"before": ["<leader>", "7"], "commands": ["workbench.action.openEditorAtIndex7"]},
    {"before": ["<leader>", "8"], "commands": ["workbench.action.openEditorAtIndex8"]},
    {"before": ["<leader>", "9"], "commands": ["workbench.action.openEditorAtIndex9"]},
    {"before": ["g", "d"], "commands": ["editor.action.revealDefinition"]},
    {"before": ["g", "D"], "commands": ["editor.action.revealDeclaration"]},
    {"before": ["g", "i"], "commands": ["editor.action.goToImplementation"]},
    {"before": ["g", "r"], "commands": ["editor.action.goToReferences"]},
    {"before": ["g", "R"], "commands": ["references-view.findReferences"]},
    {"before": ["g", "p"], "commands": ["editor.action.peekDefinition"]},
    {"before": ["K"], "commands": ["editor.action.showHover"]},
    {"before": ["]", "d"], "commands": ["editor.action.marker.next"]},
    {"before": ["[", "d"], "commands": ["editor.action.marker.prev"]},
    {"before": ["]", "g"], "commands": ["workbench.action.editor.nextChange"]},
    {"before": ["[", "g"], "commands": ["workbench.action.editor.previousChange"]},
    {"before": ["]", "x"], "commands": ["merge-conflict.next"]},
    {"before": ["[", "x"], "commands": ["merge-conflict.previous"]},
    {"before": ["<leader>", "s", "s"], "commands": ["actions.find"]},
    {"before": ["<leader>", "s", "p"], "commands": ["workbench.action.findInFiles"]},
    {"before": ["<leader>", "f", "g"], "commands": ["workbench.action.findInFiles"]},
    {"before": ["<leader>", "s", "w"], "after": ["v", "i", "w"], "commands": ["workbench.action.findInFiles"]},
    {"before": ["<leader>", "s", "r"], "commands": ["workbench.action.replaceInFiles"]},
    {"before": ["<leader>", "s", "o"], "commands": ["outline.focus"]},
    {"before": ["<leader>", "s", "u"], "commands": ["timeline.focus"]},
    {"before": ["<leader>", "c", "r"], "commands": ["editor.action.rename"]},
    {"before": ["<leader>", "r", "n"], "commands": ["editor.action.rename"]},
    {"before": ["<leader>", "c", "a"], "commands": ["editor.action.quickFix"]},
    {"before": ["<leader>", "c", "f"], "commands": ["editor.action.formatDocument"]},
    {"before": ["<leader>", "c", "x"], "commands": ["workbench.actions.view.problems"]},
    {"before": ["<leader>", "c", "X"], "commands": ["workbench.actions.view.problems"]},
    {"before": ["<leader>", "d"], "commands": ["editor.action.showHover"]},
    {"before": ["<leader>", "g", "m"], "commands": ["git.openMergeEditor"]},
    {"before": ["<leader>", "g", "r"], "commands": ["git.revertSelectedRanges"]},
    {"before": ["<leader>", "g", "g"], "commands": [{"command": "workbench.action.terminal.newWithProfile", "args": {"profileName": "lazygit", "location": "editor"}}]},
    {"before": ["<leader>", "g", "f"], "commands": [{"command": "workbench.action.terminal.newWithProfile", "args": {"profileName": "lazygit-file", "location": "editor"}}]},
    {"before": ["<leader>", "g", "h"], "commands": ["timeline.focus"]},
    {"before": ["<leader>", "g", "H"], "commands": ["git-graph.view"]},
    {"before": ["<leader>", "g", "l"], "commands": ["git-graph.view"]},
    {"before": ["<leader>", "g", "o"], "commands": ["merge-conflict.accept.current"]},
    {"before": ["<leader>", "g", "t"], "commands": ["merge-conflict.accept.incoming"]},
    {"before": ["<leader>", "g", "b"], "commands": ["merge-conflict.accept.both"]},
    {"before": ["<leader>", "t", "b"], "commands": ["git.blame.toggleEditorDecoration"]},
    {"before": ["<leader>", "o", "t"], "commands": ["workbench.action.terminal.toggleTerminal"]},
    {"before": ["<leader>", "h", "b"], "commands": ["workbench.action.openGlobalKeybindings"]},
    {"before": ["<leader>", "h", "k"], "commands": ["workbench.action.openGlobalKeybindings"]},
    {"before": ["<leader>", "h", "r"], "commands": ["workbench.action.reloadWindow"]},
    {"before": ["<leader>", "q"], "commands": ["workbench.action.closePanel"]},
    {"before": ["<leader>", "h", "a"], "commands": ["vscode-harpoon.addEditor"]},
    {"before": ["<leader>", "h", "h"], "commands": ["vscode-harpoon.editEditors"]},
    {"before": ["<leader>", "h", "d"], "commands": ["vscode-harpoon.editEditors"]},
    {"before": ["<leader>", "h", "1"], "commands": ["vscode-harpoon.gotoEditor1"]},
    {"before": ["<leader>", "h", "2"], "commands": ["vscode-harpoon.gotoEditor2"]},
    {"before": ["<leader>", "h", "3"], "commands": ["vscode-harpoon.gotoEditor3"]},
    {"before": ["<leader>", "h", "4"], "commands": ["vscode-harpoon.gotoEditor4"]},
    {"before": ["<leader>", "h", "5"], "commands": ["vscode-harpoon.gotoEditor5"]},
    {"before": ["<leader>", "h", "6"], "commands": ["vscode-harpoon.gotoEditor6"]},
    {"before": ["<leader>", "h", "7"], "commands": ["vscode-harpoon.gotoEditor7"]},
    {"before": ["<leader>", "h", "8"], "commands": ["vscode-harpoon.gotoEditor8"]},
    {"before": ["<leader>", "h", "9"], "commands": ["vscode-harpoon.gotoEditor9"]},
    {"before": ["<leader>", "h", "s", "1"], "commands": ["vscode-harpoon.addEditor1"]},
    {"before": ["<leader>", "h", "s", "2"], "commands": ["vscode-harpoon.addEditor2"]},
    {"before": ["<leader>", "h", "s", "3"], "commands": ["vscode-harpoon.addEditor3"]},
    {"before": ["<leader>", "h", "s", "4"], "commands": ["vscode-harpoon.addEditor4"]},
    {"before": ["<leader>", "h", "s", "5"], "commands": ["vscode-harpoon.addEditor5"]},
    {"before": ["<leader>", "h", "s", "6"], "commands": ["vscode-harpoon.addEditor6"]},
    {"before": ["<leader>", "h", "s", "7"], "commands": ["vscode-harpoon.addEditor7"]},
    {"before": ["<leader>", "h", "s", "8"], "commands": ["vscode-harpoon.addEditor8"]},
    {"before": ["<leader>", "h", "s", "9"], "commands": ["vscode-harpoon.addEditor9"]},
    {"before": ["y", "s", "w"], "after": ["y", "s", "i", "w"]},
    {"before": ["y", "s", "W"], "after": ["y", "s", "i", "W"]},
    {"before": ["y", "s", "p"], "after": ["y", "s", "i", "p"]},
    {"before": ["y", "s", "("], "after": ["y", "s", "i", "("]},
    {"before": ["y", "s", "{"], "after": ["y", "s", "i", "{"]},
    {"before": ["y", "s", "["], "after": ["y", "s", "i", "["]},
    {"before": ["y", "s", "<"], "after": ["y", "s", "i", "<"]},
    {"before": [";"], "after": [":"]}
  ],
  // visual mode
  "vim.visualModeKeyBindingsNonRecursive": [
    {"before": ["s"], "after": ["<leader>", "<leader>", "/"]},
    {"before": ["g", "s"], "after": ["S"]},
    {"before": ["<leader>", "c", "f"], "commands": ["editor.action.formatSelection"]},
    {"before": ["<leader>", "c", "a"], "commands": ["editor.action.quickFix"]},
    {"before": ["<leader>", "s", "r"], "commands": ["workbench.action.replaceInFiles"]},
    {"before": [";"], "after": [":"]}
  ],
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.highlightedyank.enable": true,
  "editor.cursorSurroundingLines": 5,
  "terminal.integrated.profiles.linux": {
    "lazygit": { "path": "lazygit", "icon": "git-branch" },
    "lazygit-file": { "path": "lazygit", "args": ["-f", "${file}"], "icon": "git-branch" }
  },
  // ==== end of the nvim keys block ====
  "window.density.editorTabHeight": "compact",
  "workbench.settings.showAISearchToggle": false,
  "chat.disableAIFeatures": true,
  
  
