// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "smooth_scroll": {
    "enabled": true,
  },
  "status_bar": {
    "active_file": false,
    "icon_size": "large",
    "position": "top",
    "show": true,
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "soft_wrap": "editor_width",
  "node": {
    "allow_prettier_download": true,
    "allow_binary_download": true,
    "allow_npm_install": true,
  },
  "lsp": {
    "vscode-css-language-server": {
      "binary": {
        "ignore_system_version": false,
        "enable_auto_updates": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "dockerfile-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "bash-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "docker-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "yaml-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "package-version-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "prettier (default)": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "eslint": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "tailwindcss-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "json-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "vtsls": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true,
      },
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
            "source.fixAll.eslint": true,
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
            "source.fixAll.eslint": true,
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "ui_font_weight": 450.0,
  "ui_font_size": 14.0,

  "toolbar": {
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "scrollbar": {
    "show": "auto",
  },
  "buffer_font_weight": 450.0,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "minimum_contrast_for_highlights": 50.0,
  "ui_font_family": "JetBrainsMono NF",
  "buffer_line_height": "standard",
  "outline_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "colorize_brackets": true,
  "terminal": {
    "font_family": "FiraCode Nerd Font",
    "font_weight": 450.0,
    "button": true,
    "toolbar": {
      "breadcrumbs": true,
    },
    "scroll_multiplier": 2.0,
    "font_size": 13.5,
    "default_height": 700.0,
    "default_width": 1200.0,
    "dock": "right",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "which_key": {
    "delay_ms": 50,
    "enabled": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": true,
    "show": true,
  },
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "tabs": {
    "close_position": "right",
    "show_diagnostics": "all",
    "git_status": true,
    "file_icons": true,
  },
  "title_bar": {
    "show_branch_icon": true,
    "show": false,
    "show_menus": false,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_branch_name": true,
  },
  "proxy": "",
  "icon_theme": {
    "mode": "light",
    "light": "Gram (Default)",
    "dark": "VSCode Icons for Zed (Dark)",
  },
  "project_panel": {
    "folder_icons": true,
    "file_icons": true,
    "button": true,
    "entry_spacing": "standard",
    "dock": "right",
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "gutter": {
    "runnables": true,
    "breakpoints": true,
    "line_numbers": true,
  },
  "minimap": {
    "show": "never",
  },
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "tab_size": 2,
  "base_keymap": "VSCode",
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "Zedokai Darker (Filter Machine)",
  },
}
